rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function allowedAdmin() {
      return request.auth != null && (request.auth.token.email == 'masumbillah6778@gmail.com' || request.auth.token.email == 'rationrab8@gmail.com');
    }
    match /adminUsers/{uid} {
      allow read, create, update: if allowedAdmin() && request.auth.uid == uid;
      allow delete: if false;
    }
    // User Panel requires Gmail login; records remain readable for the existing viewer behavior.
    // All writes remain restricted to the two approved Admin Gmail accounts.
    match /records/{id} {
      allow read: if true;
      allow write: if allowedAdmin();
    }
    match /deletedRecords/{id} {
      allow read, write: if allowedAdmin();
    }
    match /rationLogs/{id} {
      allow read, write: if allowedAdmin();
    }

    match /activeMembers/{uid} {
      allow read: if allowedAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
